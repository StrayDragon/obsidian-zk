{
	"compilerOptions": {
		"baseUrl": "src",
		"module": "ESNext",
		"target": "ES2018",
		"lib": [
			"DOM",
			"ES2018"
		],
		"moduleResolution": "Bundler",
		"noEmit": true,
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"isolatedModules": true,
		"useUnknownInCatchVariables": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true
	},
	"include": [
		"src/**/*.ts"
	]
}
